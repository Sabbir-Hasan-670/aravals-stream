<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>Aravals Stream</AssemblyTitle>
    <Product>Aravals Stream</Product>
    <Company>Aravals Inc.</Company>
    <Description>Live streaming and recording workstation</Description>
    <ApplicationIcon>Assets\Brand\Aravals Stream.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Brand\Aravals Stream.png" />
    <Resource Include="Assets\Brand\Aravals Stream.ico" />
    <ProjectReference Include="..\AravalsStream.Core\AravalsStream.Core.csproj" />
    <ProjectReference Include="..\AravalsStream.Capture\AravalsStream.Capture.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
  </ItemGroup>
</Project>


