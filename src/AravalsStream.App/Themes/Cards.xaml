<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:AravalsStream.Core.Models;assembly=AravalsStream.Core">
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="11"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/></Style>
  <DataTemplate x:Key="SceneRowTemplate">
    <Border x:Name="RowBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,1" SnapsToDevicePixels="True">
      <Grid Height="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusDot" Text="●" FontSize="11" Foreground="{StaticResource QuietBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,6,0"/>
        <TextBlock x:Name="SceneName" Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Border x:Name="DisabledBadge" Grid.Column="2" Background="#141E2B" BorderBrush="#253549" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,4,0" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="DISABLED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource QuietBrush}"/>
        </Border>
        <!-- Scene More Button: ALWAYS VISIBLE -->
        <Button x:Name="MoreButton" Grid.Column="3" Style="{StaticResource GhostButton}" Width="24" Height="22" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Scene options" Focusable="False">
          <Viewbox Width="13" Height="13">
            <Path x:Name="SceneMorePath" Data="M3,8 A2,2 0 1,1 3,7.99 Z M8,8 A2,2 0 1,1 8,7.99 Z M13,8 A2,2 0 1,1 13,7.99 Z" Fill="{StaticResource QuietBrush}"/>
          </Viewbox>
        </Button>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsActive}" Value="True">
        <Setter TargetName="StatusDot" Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter TargetName="StatusDot" Property="Text" Value="●"/>
        <Setter TargetName="SceneName" Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
        <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter TargetName="SceneMorePath" Property="Fill" Value="{StaticResource TextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Enabled}" Value="False">
        <Setter TargetName="StatusDot" Property="Text" Value="○"/>
        <Setter TargetName="StatusDot" Property="Foreground" Value="#54657E"/>
        <Setter TargetName="SceneName" Property="Foreground" Value="{StaticResource QuietBrush}"/>
        <Setter TargetName="DisabledBadge" Property="Visibility" Value="Visible"/>
        <Setter TargetName="RowBorder" Property="Opacity" Value="0.55"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
        <Setter TargetName="SceneMorePath" Property="Fill" Value="{StaticResource TextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding ElementName=MoreButton, Path=IsMouseOver}" Value="True">
        <Setter TargetName="SceneMorePath" Property="Fill" Value="{StaticResource TextBrush}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="SourceRowTemplate">
    <Border x:Name="SourceRowBorder" Background="Transparent" CornerRadius="6" Padding="6,4" Margin="0,1" SnapsToDevicePixels="True">
      <Grid MinHeight="36">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- Visibility quick control (Column 0: ALWAYS VISIBLE) -->
        <Button x:Name="VisibilityBtn" Grid.Column="0" Tag="ToggleVisibility" Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,4,0" ToolTip="Show / Hide source" Focusable="False">
          <Viewbox Width="14" Height="14">
            <Path x:Name="VisibilityPath" Data="M1,8 C3,4 7,1.5 8,1.5 C9,1.5 13,4 15,8 C13,12 9,14.5 8,14.5 C7,14.5 3,12 1,8 Z M8,11.5 C9.93,11.5 11.5,9.93 11.5,8 C11.5,6.07 9.93,4.5 8,4.5 C6.07,4.5 4.5,6.07 4.5,8 C4.5,9.93 6.07,11.5 8,11.5 Z M8,9.5 C8.83,9.5 9.5,8.83 9.5,8 C9.5,7.17 8.83,6.5 8,6.5 C7.17,6.5 6.5,7.17 6.5,8 C6.5,8.83 7.17,9.5 8,9.5 Z" Fill="{StaticResource AccentBrush}"/>
          </Viewbox>
        </Button>
        
        <!-- Source type icon (Column 1) -->
        <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,6,0">
          <TextBlock x:Name="TypeIcon" Text="🖥" Foreground="{StaticResource SecondaryBrush}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Source info (Column 2: strictly constrained so it shrinks and truncates) -->
        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="SourceName" Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Row="1" x:Name="SourceStatus" Text="{Binding State}" Style="{StaticResource TinyText}" TextTrimming="CharacterEllipsis"/>
        </Grid>
        
        <!-- Lock quick control (Column 3: ALWAYS VISIBLE) -->
        <Button x:Name="LockBtn" Grid.Column="3" Tag="ToggleLock" Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,2,0" ToolTip="Lock / Unlock transform" Focusable="False">
          <Viewbox Width="12" Height="12">
            <Path x:Name="LockPath" Data="M4,6 L4,4 C4,1.8 5.8,0 8,0 C10.2,0 12,1.8 12,4 L10,4 C10,2.9 9.1,2 8,2 C6.9,2 6,2.9 6,4 L6,6 L13,6 C14.1,6 15,6.9 15,8 L15,14 C15,15.1 14.1,16 13,16 L3,16 C1.9,16 1,15.1 1,14 L1,8 C1,6.9 1.9,6 3,6 L4,6 Z M6,6 L10,6 L10,4 C10,2.9 9.1,2 8,2 C6.9,2 6,2.9 6,4 L6,6 Z" Fill="{StaticResource QuietBrush}"/>
          </Viewbox>
        </Button>

        <!-- Three-dot more button (Column 4: ALWAYS VISIBLE) -->
        <Button x:Name="MoreBtn" Grid.Column="4" Tag="MoreSource" Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="Source options" Focusable="False">
          <Viewbox Width="13" Height="13">
            <Path x:Name="MorePath" Data="M3,8 A2,2 0 1,1 3,7.99 Z M8,8 A2,2 0 1,1 8,7.99 Z M13,8 A2,2 0 1,1 13,7.99 Z" Fill="{StaticResource QuietBrush}"/>
          </Viewbox>
        </Button>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <!-- Visibility triggers -->
      <DataTrigger Binding="{Binding Visible}" Value="False">
        <Setter TargetName="VisibilityPath" Property="Data" Value="M2,2 L14,14 M1,8 C3,4 7,1.5 8,1.5 C9,1.5 13,4 15,8 C13,12 9,14.5 8,14.5 C7,14.5 3,12 1,8 Z"/>
        <Setter TargetName="VisibilityPath" Property="Fill" Value="{StaticResource QuietBrush}"/>
        <Setter TargetName="SourceRowBorder" Property="Opacity" Value="0.55"/>
      </DataTrigger>
      
      <!-- Lock triggers -->
      <DataTrigger Binding="{Binding Locked}" Value="True">
        <Setter TargetName="LockPath" Property="Data" Value="M4,6 L4,4 C4,1.8 5.8,0 8,0 C10.2,0 12,1.8 12,4 L12,6 L13,6 C14.1,6 15,6.9 15,8 L15,14 C15,15.1 14.1,16 13,16 L3,16 C1.9,16 1,15.1 1,14 L1,8 C1,6.9 1.9,6 3,6 L4,6 Z M6,6 L10,6 L10,4 C10,2.9 9.1,2 8,2 C6.9,2 6,2.9 6,4 L6,6 Z"/>
        <Setter TargetName="LockPath" Property="Fill" Value="{StaticResource WarningBrush}"/>
        <Setter TargetName="LockBtn" Property="ToolTip" Value="Locked (Click to unlock)"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Locked}" Value="False">
        <Setter TargetName="LockPath" Property="Data" Value="M4,6 L4,4 C4,1.8 5.8,0 8,0 C10.2,0 12,1.8 12,4 L10,4 C10,2.9 9.1,2 8,2 C6.9,2 6,2.9 6,4 L6,6 L13,6 C14.1,6 15,6.9 15,8 L15,14 C15,15.1 14.1,16 13,16 L3,16 C1.9,16 1,15.1 1,14 L1,8 C1,6.9 1.9,6 3,6 L4,6 Z M6,6 L10,6 L10,4 C10,2.9 9.1,2 8,2 C6.9,2 6,2.9 6,4 L6,6 Z"/>
        <Setter TargetName="LockPath" Property="Fill" Value="{StaticResource QuietBrush}"/>
        <Setter TargetName="LockBtn" Property="ToolTip" Value="Unlocked (Click to lock)"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding HorizontalTransform.Locked}" Value="True">
        <Setter TargetName="LockPath" Property="Data" Value="M4,6 L4,4 C4,1.8 5.8,0 8,0 C10.2,0 12,1.8 12,4 L12,6 L13,6 C14.1,6 15,6.9 15,8 L15,14 C15,15.1 14.1,16 13,16 L3,16 C1.9,16 1,15.1 1,14 L1,8 C1,6.9 1.9,6 3,6 L4,6 Z M6,6 L10,6 L10,4 C10,2.9 9.1,2 8,2 C6.9,2 6,2.9 6,4 L6,6 Z"/>
        <Setter TargetName="LockPath" Property="Fill" Value="{StaticResource WarningBrush}"/>
        <Setter TargetName="LockBtn" Property="ToolTip" Value="Locked (Click to unlock)"/>
      </DataTrigger>

      <!-- Source type icons -->
      <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SourceType.DisplayCapture}">
        <Setter TargetName="TypeIcon" Property="Text" Value="🖥"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SourceType.WindowCapture}">
        <Setter TargetName="TypeIcon" Property="Text" Value="▤"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SourceType.Camera}">
        <Setter TargetName="TypeIcon" Property="Text" Value="📷"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SourceType.CaptureDevice}">
        <Setter TargetName="TypeIcon" Property="Text" Value="▣"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SourceType.AudioInput}">
        <Setter TargetName="TypeIcon" Property="Text" Value="🎙"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SourceType.AudioOutput}">
        <Setter TargetName="TypeIcon" Property="Text" Value="🔊"/>
      </DataTrigger>

      <!-- Capture state coloring -->
      <DataTrigger Binding="{Binding State}" Value="{x:Static models:CaptureState.Active}">
        <Setter TargetName="SourceStatus" Property="Foreground" Value="{StaticResource AccentBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="{x:Static models:CaptureState.Unavailable}">
        <Setter TargetName="SourceStatus" Property="Foreground" Value="{StaticResource WarningBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="{x:Static models:CaptureState.Recovering}">
        <Setter TargetName="SourceStatus" Property="Foreground" Value="{StaticResource WarningBrush}"/>
      </DataTrigger>

      <!-- Hover / Selection triggers -->
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
        <Setter TargetName="MorePath" Property="Fill" Value="{StaticResource TextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
        <Setter TargetName="MorePath" Property="Fill" Value="{StaticResource TextBrush}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="DestinationCardTemplate">
    <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,10">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
            <Path Data="{Binding IconData}" Fill="{StaticResource AccentBrush}"/>
          </Viewbox>
          <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <CheckBox Grid.Column="2" IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Horizontal status block -->
        <Border Margin="0,8,0,0">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsHorizontalVisible}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="{Binding HorizontalStatusDisplay}" ToolTip="{Binding HorizontalStatusDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding HorizontalDetailsText}" ToolTip="{Binding HorizontalDetailsText}" Style="{StaticResource TinyText}" Margin="12,2,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Vertical status block -->
        <Border Margin="0,6,0,0">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsVerticalVisible}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="{Binding VerticalStatusDisplay}" ToolTip="{Binding VerticalStatusDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding VerticalDetailsText}" ToolTip="{Binding VerticalDetailsText}" Style="{StaticResource TinyText}" Margin="12,2,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Quick routing pills & Mode badge -->
        <Grid Margin="0,10,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="H" Tag="QuickRouteH" Style="{StaticResource GhostButton}" Padding="7,2" Margin="0,0,3,0" ToolTip="Horizontal only" FontSize="10" FontWeight="Bold"/>
            <Button Content="V" Tag="QuickRouteV" Style="{StaticResource GhostButton}" Padding="7,2" Margin="0,0,3,0" ToolTip="Vertical only" FontSize="10" FontWeight="Bold"/>
            <Button Content="H+V" Tag="QuickRouteBoth" Style="{StaticResource GhostButton}" Padding="7,2" ToolTip="Both Horizontal and Vertical" FontSize="10" FontWeight="Bold"/>
          </StackPanel>
          <Border Grid.Column="1" HorizontalAlignment="Right" Background="{StaticResource RaisedBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Text="{Binding ModeBadgeText}" Style="{StaticResource TinyText}" FontWeight="SemiBold"/>
          </Border>
        </Grid>

        <!-- Action buttons: Edit and More -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
          <Button Content="⚙ Edit" Tag="{Binding}" Style="{StaticResource GhostButton}" Padding="6,2" Margin="0,0,4,0"/>
          <Button Content="⋯" Tag="{Binding}" Style="{StaticResource GhostButton}" Padding="8,2"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="AudioMixerRowTemplate"><Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8"><StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Device…" Tag="audio-device" Style="{StaticResource GhostButton}" Padding="6,3" ToolTip="Change microphone or desktop audio device"/><Button Content="Filters…" Tag="audio-filters" Style="{StaticResource GhostButton}" Padding="6,3" ToolTip="Noise suppression, noise gate, compressor, gain and limiter"/></StackPanel>
    <StackPanel><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Active, StringFormat=Active: {0}}" Style="{StaticResource TinyText}"/></StackPanel>
    <ProgressBar Value="{Binding Peak, Mode=OneWay}" Maximum="1" Height="9" Margin="0,9,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="◖" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" FontSize="16"/><Slider Grid.Column="1" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="2" Margin="2,0,10,0"/><CheckBox Grid.Column="2" Content="Mute" IsChecked="{Binding Muted, Mode=TwoWay}" VerticalAlignment="Center"/></Grid>
  </StackPanel></Border></DataTemplate>
</ResourceDictionary>






