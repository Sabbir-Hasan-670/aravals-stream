<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource ShellBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="Brand" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="TinyText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource QuietBrush}"/><Setter Property="FontSize" Value="11"/></Style>
</ResourceDictionary>
