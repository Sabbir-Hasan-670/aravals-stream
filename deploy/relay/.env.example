# Generate both values with a cryptographically secure random generator.
ASPNETCORE_ENVIRONMENT=Production
# Relay refuses enrollment without a signing key of at least 32 random bytes (Base64).
RELAY_TOKEN_SIGNING_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
# Each code is one-time, high entropy, and scoped to exact provider/channel claims.
# Create a separate entry for each trusted Desktop installation; never reuse a code.
RELAY_ENROLLMENT_CREDENTIALS_JSON=[{"code":"REPLACE_WITH_RANDOM_ENROLLMENT_CODE_32_CHARS_MIN","channels":["kick:YOUR_KICK_USER_ID","facebook:YOUR_PAGE_ID"]}]

# Public HTTPS callback host, without scheme or port.
RELAY_ALLOWED_HOSTS=relay.example.invalid
RELAY_PUBLIC_BASE_URL=https://relay.example.invalid
RELAY_STORAGE_PATH=/data/relay-state.json
# IP address of the single reverse proxy directly in front of the service.
RELAY_TRUSTED_PROXY=127.0.0.1

# PEM public key published by Kick for webhook signature verification.
KICK_WEBHOOK_PUBLIC_KEY_FILE=/config/kick-public.pem
# Enable only after configuring the same application's webhook in Kick's developer settings.
# No app secret is required on Relay: Desktop supplies its current user access token per authenticated operation.
KICK_SUBSCRIPTIONS_ENABLED=false
KICK_APP_ID=REPLACE_WITH_KICK_APPLICATION_CLIENT_ID
KICK_CONFIGURED_WEBHOOK_URL=https://relay.example.invalid/webhooks/kick
# Meta app settings for Graph Webhooks verification and X-Hub-Signature-256.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN
FACEBOOK_APP_SECRET=REPLACE_WITH_META_APP_SECRET
FACEBOOK_WEBHOOKS_ENABLED=false
